                                </span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="box">
                        <div class="slide-img">
                            <img src="/img/img2.jpg" alt="1">
                            <div class="overlay">
                                <a href="#" class="buy-btn">سفارش</a>
                            </div>
                        </div>
                        <div class="product-name mt-1">
                            <span class="product-category">کارت ویزیت</span>
                            <a href="#">کارت ویزیت براق</a>
                        </div>
                        <div class="detail-box">
                            <a class="price">
                                30000
                                <span>
                                    <img src="/img/Toman.svg" class="currency-svg" alt="">
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="box">
                        <div class="slide-img">
                            <img src="/img/img2.jpg" alt="1">
                            <div class="overlay">
                                <a href="#" class="buy-btn">سفارش</a>
                            </div>
                        </div>
                        <div class="product-name mt-1">
                            <span class="product-category">کارت ویزیت</span>
                            <a href="#">کارت ویزیت براق</a>
                        </div>
                        <div class="detail-box">
                            <a class="price">
                                30000
                                <span>
                                    <img src="/img/Toman.svg" class="currency-svg" alt="">
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="box">
                        <div class="slide-img">
                            <img src="/img/img2.jpg" alt="1">
                            <div class="overlay">
                                <a href="#" class="buy-btn">سفارش</a>
                            </div>
                        </div>
                        <div class="product-name mt-1">
                            <span class="product-category">کارت ویزیت</span>
                            <a href="#">کارت ویزیت براق</a>
                        </div>
                        <div class="detail-box">
                            <a class="price">
                                30000
                                <span>
                                    <img src="/img/Toman.svg" class="currency-svg" alt="">
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="product-comments drop-shadow my-3 p-4">
        <div class="title">
            <h4 class="text-gradient">نظرات کاربران</h4>
        </div>
        <div class="title-underline"></div>

        <div class="comments-wrapper mt-4" dir="rtl">
            <div class="comment-form-box mb-5">
                <form>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="custom-field">
                                <i class="uil uil-comment-alt-notes"></i>
                                <textarea rows="4" placeholder="متن نظر شما..."></textarea>
                            </div>
                        </div>

                        <div class="col-12 text-start mt-2">
                            @* <button type="submit" class="submit-btn-modern"> *@
                            <button type="submit" class="default-yellow-btn">
                                <i class="uil uil-message me-2"></i>
                                <span> ارسال دیدگاه</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="comments-list">
                <div class="comment-item">
                    <div class="comment-header">
                        <div class="user-meta">
                            <div class="user-icon-box">
                                <i class="uil uil-user"></i>
                            </div>
                            <div class="ms-3 me-3">
                                <h6 class="m-0">مشتری گرامی</h6>
                                <small class="text-muted">۲ روز قبل</small>
                            </div>
                        </div>
                        <button class="modern-reply-btn">
                            <i class="uil uil-share"></i>
                            <span>پاسخ</span>
                        </button>
                    </div>
                    <p class="comment-content">محصول به دستم رسید، کیفیت چاپ واقعا عالی بود.</p>

                    <div class="admin-reply-box">
                        <div class="admin-head">
                            <span class="badge-admin">مدیریت</span>
                            <small class="text-muted">۱ روز قبل</small>
                        </div>
                        <p class="m-0">سلام، ممنون از حسن انتخاب شما. خوشحالیم که راضی بودید.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>