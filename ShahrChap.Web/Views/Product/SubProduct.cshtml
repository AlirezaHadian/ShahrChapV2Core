                        </div>
                        <div class="detail-box">
                            <a class="price">
                                30000
                                <span>
                                    <img src="/img/Toman.svg" class="currency-svg" alt="">
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="swiper-slide">
                    <div class="box">
                        <div class="slide-img">
