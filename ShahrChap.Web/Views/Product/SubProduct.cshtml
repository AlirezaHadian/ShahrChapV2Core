@using ShahrChap.Core.DTOs.Products
@using ShahrChap.Core.Services.Interfaces
@inject IUserService _userService
@inject IProductService _productService
@inject IPermissionService _permissionService

@model SubProductForShowViewMode
@{
    ViewData["Title"] = Model.SubProduct.ProductTitle;
    List<int> SelectedValues = ViewBag.SelectedFeatureValues as List<int>;
}

<section class="single-product container internal-style py-3">
    <ol class="breadcrumb drop-shadow">
        <li class="breadcrumb-item"><a href="/">خانه</a></li>
        <li class="breadcrumb-item"><a href="#">محصولات</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.SubProduct.ProductTitle</li>
    </ol>
    <div class="main-wrapper">
        <div class="product-div drop-shadow">
            <div class="product-div-right mt-5">
                <div class="img-container">
                    <a href="/product/image/@Model.SubProduct.Image" data-lightbox="product" data-title="@Model.SubProduct.ProductTitle">
                        <img src="/product/image/@Model.SubProduct.Image" alt="@Model.SubProduct.ProductTitle" title="@Model.SubProduct.ProductTitle">
                    </a>
                </div>
                <div class="hover-container">
                    <div class="img-box drop-shadow">
                        <a href="/product/image/@Model.SubProduct.Image" data-lightbox="product" data-title="@Model.SubProduct.ProductTitle">
                            <img src="/product/image/@Model.SubProduct.Image" alt="@Model.SubProduct.ProductTitle" title="@Model.SubProduct.ProductTitle">
                        </a>
                    </div>
                    @foreach (var image in Model.SubProduct.ProductGalleries)
                    {
                        <div class="img-box drop-shadow">
                            <a href="/product/image/@image.ImageName data-lightbox="product" data-title="@image.ImageTitle">
                                <img src="/product/image/@image.ImageName" alt="@image.ImageTitle" title="@image.ImageTitle">
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="product-div-left">
                <div class="product-header">
                    <h2 class="single-product-title">کارت ویزیت براق</h2>
                    <span>
                        <a href="" class="share-btn drop-shadow">
                            <i class="uil uil-link-alt"></i>
                        </a>
                    </span>
                </div>
                <div class="product-detail">
                    <h2>درباره محصول:</h2>
                    <p>
                        @Html.Raw(Model.SubProduct.Description)
                    </p>
                    @* Product Features *@
                    <div class="product-custom-config mx-auto mt-3">
                        <input type="hidden" asp-for="SubProduct.ProductId" />
                        <div class="row g-2" dir="rtl">
                            <div class="col-12 mb-1">
                                <div class="clean-input-group">
                                    <input type="text" id="order-title" class="form-control" placeholder="عنوان سفارش">
                                </div>
                            </div>
                            @foreach (var feature in Model.ProductFeatures)
                            {
                                @if (feature.Feature.FeatureValues.Any(value => SelectedValues.Contains(value.FeatureValueId)))
                                {
                                    <div class="col-12 col-md-6">
                                        <div class="clean-input-group">
                                            <select class="form-select" name="feature_@feature.PF_Id">
                                                <option selected disabled>@feature.Feature.FeatureTitle</option>
                                                @foreach (var value in feature.Feature.FeatureValues)
                                                {
                                                    @if (SelectedValues.Any(p => p == value.FeatureValueId))
                                                    {
                                                        <option value="@value.FeatureValueId">@value.ValueTitle</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                            }

                        </div>
                    </div>
                </div>
                @* Product Services *@
                @if (Model.Services.Any())
                {
                    <div class="product-services-section mx-auto mt-4">
                        <div class="modern-header-style mb-3">
                            <h5 class="m-0">خدمات پس از چاپ</h5>
                        </div>

                        <div class="services-list" dir="rtl">
                            @foreach (var service in Model.Services)
                            {
                                <label class="service-row">
                                    <div class="service-info">
                                        <span class="service-name">@service.ServiceTitle</span>
                                    </div>
                                    <div class="checkbox-wrapper">
                                        <input type="checkbox" class="service-check" value="@service.ServiceId">
                                        <span class="check-knob"></span>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                }

                @* Purchase Info *@
                <div class="purchase-info">
                    <div class="product-price drop-shadow">
                        <span id="desktop-price">۰</span>  تومان
                        <i class="uil uil-pricetag-alt"></i>
                    </div>

                    <a type="button" class="btn addcart-btn drop-shadow"
                       data-is-logged-in="@(ViewBag.IsUserLoggedIn.ToString().ToLower())">
                        <span class="large-addcart-btn">
                            ثبت سفارش <i class="uil uil-shopping-cart"></i>
                        </span>

                        <span class="small-addcart-btn">
                            <span id="mobile-price">۰</span>  تومان
                            <i class="uil uil-plus-circle"></i>
                        </span>
                    </a>

                </div>
            </div>
        </div>
    </div>
    <div id="validation-toast" class="validation-message"></div>
    @* Form Upload Modal *@
    <div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">آپلود فایل ها</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="upload-drop-zone" onclick="document.getElementById('order-file').click()">
                        <i class="uil uil-upload fs-1 text-warning"></i>
                        <p class="mt-2 mb-0">کلیک کنید و فایل‌های خود را انتخاب کنید</p>
                        <small class="text-muted">حداکثر حجم هر فایل: ۵۰ مگابایت</small>
                        <input type="file" id="order-file" multiple hidden>
                    </div>

                    <div id="file-list" class="mt-3"></div>

                    <div class="progress mt-4 d-none" style="height: 20px; border-radius: 10px;">
                        <div id="upload-progress" class="progress-bar bg-warning progress-bar-striped progress-bar-animated"
                             role="progressbar" style="width: 0%">
                            0%
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" id="final-submit-btn" class="btn btn-warning w-100 py-3 fw-bold" disabled>
                        ثبت نهایی
                    </button>
                </div>
            </div>
        </div>
    </div>

