@model ShahrChap.DataLayer.Entities.Product.Product

@{
    ViewData["Title"] = Model.ProductTitle;
}

<section class="single-product container internal-style py-3">
    <ol class="breadcrumb drop-shadow">
        <li class="breadcrumb-item"><a href="#">خانه</a></li>
        <li class="breadcrumb-item"><a href="#">محصولات</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.ProductTitle</li>
    </ol>
    <div class="main-wrapper">
        <div class="product-div drop-shadow">
            <div class="product-div-right">
                <div class="img-container">
                    <a href="/product/image/@Model.Image" data-lightbox="product" data-title="@Model.ProductTitle">
                        <img src="/product/image/@Model.Image" alt="@Model.ProductTitle" title="@Model.ProductTitle">
                    </a>
                </div>
                <div class="hover-container">
                    <div class="img-box drop-shadow">
                        <a href="/product/image/@Model.Image" data-lightbox="product" data-title="@Model.ProductTitle">
                            <img src="/product/image/@Model.Image" alt="@Model.ProductTitle" title="@Model.ProductTitle">
                        </a>
                    </div>
                    @foreach(var image in Model.ProductGalleries)
                    {
                        <div class="img-box drop-shadow">
                            <a href="/product/image/@image.ImageName data-lightbox="product" data-title="@image.ImageTitle">
                                <img src="/product/image/@image.ImageName" alt="@image.ImageTitle" title="@image.ImageTitle">
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="product-div-left">
                <div class="product-header">
                    <h2 class="single-product-title">کارت ویزیت براق</h2>
                    <span>
                        <a href="" class="share-btn drop-shadow">
                            <i class="uil uil-link-alt"></i>
                        </a>
                    </span>
                </div>
                <div class="product-detail">
                    <h2>درباره محصول:</h2>
                    <p>
                        @Model.Description
                    </p>
                    <!-- <ul>
                        <li>رنگ: <span>مشکی</span></li>
                        <li>رنگ: <span>مشکی</span></li>
                        <li>رنگ: <span>مشکی</span></li>
                        <li>رنگ: <span>مشکی</span></li>
                      </ul> -->
                    <div class="product-custom-section">
                        <div class="modern-form-wrapper">

                            <div class="custom-input-group">
                                <input type="text" placeholder="متن دلخواه جهت چاپ...">
                            </div>

                            <div class="custom-row">
                                <div class="custom-input-group">
                                    <select>
                                        <option selected disabled>انتخاب ابعاد</option>
                                        <option>۹ در ۶ سانتی‌متر</option>
                                        <option>۸.۵ در ۴.۸ سانتی‌متر</option>
                                    </select>
                                </div>
                                <div class="custom-input-group">
                                    <select>
                                        <option selected disabled>نوع کاغذ</option>
                                        <option>لمینت براق</option>
                                        <option>کتان آلمان</option>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="purchase-info">
                    <div class="product-price drop-shadow">
                        ۱۵۰,۰۰۰ تومان
                        <i class="uil uil-pricetag-alt"></i>
                    </div>
                    <a type="button" class="btn addcart-btn drop-shadow">
                        <span class="large-addcart-btn">
                            افزودن به سبد خرید <i class="uil uil-shopping-cart"></i>
                        </span>
                        <span class="small-addcart-btn">
                            50000 تومان
                            <i class="uil uil-plus-circle"></i>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="featured-products drop-shadow my-3 p-4">
        <div class="title">
            <h4 class="text-gradient">محصولات مشابه</h4>
        </div>

        <div class="title-underline"></div>
