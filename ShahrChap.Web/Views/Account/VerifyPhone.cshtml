@model ShahrChap.Core.DTOs.VerifyPhoneViewModel

@{
    ViewData["Title"] = "کد تایید";

    string phoneNumber = ViewBag.PhoneNumber as string ?? "";
    DateTime? otpExpireTime = ViewBag.OtpExpireTime as DateTime?;
    bool otpError = ViewBag.OtpError is bool error && error;
}

@if (ViewBag.ToastrMessage != null)
{
    <partial name="_ToastrAlert" />

    <script>
        setTimeout(function () {
            window.location.href = "/Login";
        }, 3000);
    </script>
}

<section class="container internal-style pt-3">
    <ol class="breadcrumb drop-shadow">
        <li class="breadcrumb-item">
            <a href="/">خانه</a>
        </li>

        <li class="breadcrumb-item active" aria-current="page">
            کد تایید
        </li>
    </ol>
</section>

<div class="register-page otp-page drop-shadow">
    <div class="container register-container otp">

        <span class="register-title">
            کد تایید را وارد کنید
        </span>

        <p class="mt-3">
            کد تایید برای شماره
            <strong>@phoneNumber</strong>
            پیامک شد.
        </p>

        <form asp-action="VerifyPhone"
              method="post"
              id="verify-phone">

            @Html.AntiForgeryToken()

            <div class="otp-input-field"
                 id="otpInputs"
                 dir="ltr"
                 data-otp-error="@(otpError ? "true" : "false")">

                <input type="text"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       maxlength="1"
                       autocomplete="one-time-code"
                       aria-label="رقم اول کد تایید" />

                <input type="text"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       maxlength="1"
                       aria-label="رقم دوم کد تایید" />

                <input type="text"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       maxlength="1"
                       aria-label="رقم سوم کد تایید" />

                <input type="text"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       maxlength="1"
                       aria-label="رقم چهارم کد تایید" />

                <input type="text"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       maxlength="1"
                       aria-label="رقم پنجم کد تایید" />

            </div>

            <input type="hidden" asp-for="Otp" id="Otp" />

            <span asp-validation-for="Otp"
                  class="text-danger mt-2 d-block">
            </span>

            <div class="register-btn otp-verify">
                <input type="submit"
                       class="signup-btn"
                       value="تایید"
                       disabled />
            </div>
        </form>

        <div class="resend d-flex flex-column align-items-center mt-3">

            <span class="otp-timer"
                  id="otpTimer"
                  data-expire-time="@otpExpireTime?.ToString("O")">
                --:--
            </span>

            <p class="resend-text">
                کد تایید را دریافت نکردید؟

                <form asp-action="ResendOtpCode"
                      method="post"
                      id="resend-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="resend-button disableClick"
                            id="resendCode"
                            disabled>
                        ارسال مجدد
                    </button>
                </form>
            </p>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/VerifyPhone.js" asp-append-version="true"></script>
}