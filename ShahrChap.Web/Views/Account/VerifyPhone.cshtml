@model ShahrChap.Core.DTOs.VerifyPhoneViewModel

@{
    ViewData["Title"] = "کد تایید";

    string phoneNumber = ViewBag.PhoneNumber;
    string actionType = ViewBag.ActionType;
}

@if (ViewBag.ToastrMessage != null)
{
    <partial name="_ToastrAlert" />

    <script>
        setTimeout(function () {
            window.location = "/Login";
        }, 3000);
    </script>
}


<section class="container internal-style pt-3">
    <ol class="breadcrumb drop-shadow">
        <li class="breadcrumb-item">
            <a href="/">خانه</a>
        </li>

        <li class="breadcrumb-item active" aria-current="page">
            کد تایید
        </li>
    </ol>
</section>


<div class="register-page otp-page drop-shadow">

    <div class="container register-container otp">

        <span class="register-title">
            کد تایید را وارد کنید
        </span>

        <p class="mt-3">
            کد تایید برای شماره
            <strong>@phoneNumber</strong>
            پیامک شد.
        </p>


        <form asp-action="VerifyPhone"
              method="post"
              id="verify-phone">

            @Html.AntiForgeryToken()


            <div class="otp-input-field" dir="ltr">

                <input type="number"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="1" />

                <input type="number"
                       inputmode="numeric"
                       maxlength="1"
                       disabled />

                <input type="number"
                       inputmode="numeric"
                       maxlength="1"
                       disabled />

                <input type="number"
                       inputmode="numeric"
                       maxlength="1"
                       disabled />

                <input type="number"
                       inputmode="numeric"
                       maxlength="1"
                       disabled />

            </div>


            <input type="hidden"
                   asp-for="Otp"
                   id="Otp" />


            <span asp-validation-for="Otp"
                  class="text-danger mt-2">
            </span>


            <div class="register-btn otp-verify">

                <input type="submit"
                       class="signup-btn"
                       value="تایید" />

            </div>


            <div class="resend d-flex flex-column align-items-center mt-3">

                <span class="otp-timer"
                      id="otpTimer">
                    1:40
                </span>


                <p class="resend-text">

                    کد تایید را دریافت نکردید؟

                    <button type="submit"
                            formaction="@Url.Action("ResendOtpCode")"
                            formmethod="post"
                            class="disableClick"
                            id="resendCode"
                            disabled>

                        ارسال مجدد

                    </button>

                </p>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/VerifyPhone.js"></script>
}