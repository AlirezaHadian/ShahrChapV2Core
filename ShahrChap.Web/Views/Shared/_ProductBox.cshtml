@using ShahrChap.Core.DTOs.Products
@model ShowProductListViewModel

<div class="swiper-slide">
    <div class="box">
        <div class="slide-img">
            <img src="/product/thumb/@Model.ImageName" alt="1">
            <div class="overlay">
                <a href="#" class="buy-btn">سفارش</a>
            </div>
        </div>
        <div class="product-name mt-1">
            <span class="product-category">@Model.GroupName</span>
            <a href="#">@Model.ProductName</a>
        </div>
    </div>
</div>