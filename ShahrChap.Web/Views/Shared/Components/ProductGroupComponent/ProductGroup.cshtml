@using ShahrChap.Core.DTOs.Products
@model List<MainMenuViewModel>

@foreach (var item in Model)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle"
           href="#"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">

            <i class="@item.IconClass"></i> @item.GroupTitle
        </a>

        @if (item.SubGroups.Any())
        {
            <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                <ul>
                    @foreach (var sub in item.SubGroups)
                    {
                        <li>
                            <a class="dropdown-item" href="#">
                                @sub.GroupTitle
                            </a>

                            @if (sub.Products.Any())
                            {
                                <ul>
                                    @foreach (var product in sub.Products)
                                    {
                                        <li>
                                            <a class="dropdown-item"
   asp-controller="Product"
   asp-action="ShowProduct"
   asp-route-id="@product.ProductId">
    @product.ProductTitle
</a>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </li>
}
