@model dynamic

<div style="direction:rtl; text-align:center; font-family:Tahoma, Arial, sans-serif; background-color:#f7f7f7; padding:30px 15px;">

    <div style="max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #eeeeee;">

        <div style="background-color:#F0BB0F; padding:25px 20px; color:#222222;">
            <h1 style="margin:0; font-size:30px; font-weight:bold;">شهر چاپ</h1>
            <h3 style="margin:12px 0 0; font-size:18px; font-weight:normal;">
                بازیابی کلمه عبور
            </h3>
        </div>

        <div style="padding:35px 25px; color:#333333;">

            <h3 style="margin:0 0 20px; font-size:20px;">
                @Model.User.UserName عزیز!
            </h3>

            <p style="margin:0 0 15px; color:#666666; font-size:14px; line-height:2;">
                برای تغییر کلمه عبور حساب کاربری خود در شهر چاپ، روی دکمه زیر کلیک کنید.
            </p>

            <p style="margin:0 0 30px; color:#666666; font-size:14px; line-height:2;">
                اگر شما درخواست بازیابی کلمه عبور را نداده‌اید، این ایمیل را نادیده بگیرید.
            </p>

            <a href="@Model.ResetUrl"
               style="display:inline-block; background-color:#F0BB0F; color:#222222; text-decoration:none; padding:14px 35px; border-radius:8px; font-size:15px; font-weight:bold;">
                بازیابی کلمه عبور
            </a>

            <p style="margin:30px 0 8px; color:#888888; font-size:12px; line-height:2;">
                اگر دکمه بالا کار نکرد، لینک زیر را در مرورگر خود کپی کنید:
            </p>

            <p style="margin:0; font-size:12px; line-height:2; word-break:break-all; direction:ltr;">
                <a href="@Model.ResetUrl"
                   style="color:#9a7600; text-decoration:underline;">
                    @Model.ResetUrl
                </a>
            </p>

        </div>

        <div style="background-color:#fafafa; border-top:1px solid #eeeeee; padding:18px 15px;">
            <p style="margin:0; color:#999999; font-size:12px; line-height:2;">
                این ایمیل به‌صورت خودکار از طرف شهر چاپ ارسال شده است.
            </p>
        </div>

    </div>
</div>