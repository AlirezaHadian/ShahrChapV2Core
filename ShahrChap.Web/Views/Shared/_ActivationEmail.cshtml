@model ShahrChap.DataLayer.Entities.User.User

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فعالسازی حساب کاربری | شهر چاپ</title>
</head>

<body style="
    margin:0;
    padding:0;
    background-color:#f4f5f7;
    font-family:Tahoma, Arial, sans-serif;
    direction:rtl;
    ">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#f4f5f7; padding:40px 15px;">
        <tr>
            <td align="center">

                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                       style="
                    max-width:600px;
                    background:#ffffff;
                    border-radius:16px;
                    overflow:hidden;
                    box-shadow:0 8px 30px rgba(0,0,0,0.08);
                    ">

                    <!-- Header -->
                    <tr>
                        <td style="
                            background:#111111;
                            padding:28px 30px;
                            text-align:center;
                            ">
                            <div style="
                                font-size:28px;
                                font-weight:bold;
                                color:#F0BB0F;
                                letter-spacing:-1px;
                                ">
                                شهر چاپ
                            </div>

                            <div style="
                                margin-top:8px;
                                color:#bdbdbd;
                                font-size:13px;
                                ">
                                چاپ با کیفیت، ساده و مطمئن
                            </div>
                        </td>
                    </tr>

                    <!-- Main -->
                    <tr>
                        <td style="padding:40px 35px 35px;">

                            <div style="
                                width:64px;
                                height:64px;
                                line-height:64px;
                                margin:0 auto 25px;
                                background:#fff8dc;
                                border-radius:50%;
                                text-align:center;
                                font-size:28px;
                                ">
                                ✓
                            </div>

                            <h2 style="
                                margin:0;
                                text-align:center;
                                color:#222222;
                                font-size:22px;
                                ">
                                فعالسازی حساب کاربری
                            </h2>

                            <p style="
                                margin:25px 0 0;
                                text-align:right;
                                color:#333333;
                                font-size:15px;
                                line-height:2;
                                ">
                                <strong>@Model.UserName عزیز</strong>
                            </p>

                            <p style="
                                margin:8px 0 0;
                                text-align:right;
                                color:#666666;
                                font-size:14px;
                                line-height:2;
                                ">
                                از ثبت‌نام شما در شهر چاپ سپاسگزاریم.
                                برای تکمیل ثبت‌نام و فعالسازی حساب کاربری،
                                روی دکمه زیر کلیک کنید.
                            </p>

                            <!-- Button -->
                            <div style="
                                text-align:center;
                                margin:35px 0;
                                ">
                                <a href="https://localhost:7254/Account/ActiveEmail/@Model.ActiveCode"
                                   style="
                                    display:inline-block;
                                    background:#F0BB0F;
                                    color:#111111;
                                    text-decoration:none;
                                    padding:14px 42px;
                                    border-radius:10px;
                                    font-size:15px;
                                    font-weight:bold;
                                    ">
                                    فعالسازی حساب
                                </a>
                            </div>

                            <p style="
                                margin:0;
                                padding:18px;
                                background:#f8f8f8;
                                border-radius:10px;
                                color:#777777;
                                font-size:12px;
                                line-height:2;
                                text-align:right;
                                ">
                                اگر این درخواست توسط شما انجام نشده است،
                                می‌توانید این ایمیل را نادیده بگیرید.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="
                            border-top:1px solid #eeeeee;
                            padding:22px 30px;
                            text-align:center;
                            background:#fafafa;
                            ">

                            <div style="
                                color:#999999;
                                font-size:12px;
                                line-height:2;
                                ">
                                این ایمیل به صورت خودکار ارسال شده است.
                                <br>
                                © شهر چاپ
                            </div>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
```
