@using ShahrChap.Core.Convertors
@using System.IO
@model ShahrChap.Core.DTOs.Cart.CartDetailsViewModel
@{
    ViewBag.Title = "سبد خرید";
}
<section>
    <div class="container my-5">
        <div class="row">
            <div class="col-lg-8">
                <h4 class="fw-bold mb-4">سبد خرید شما</h4>

                <div id="cart-items-wrapper">

                    @if (Model.Items?.Any() == true)
                    {
                        @foreach (var item in Model.Items)
                        {
                            <div class="card border-0 shadow-sm mb-3 cart-item" data-id="@item.CartItemID">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">@item.ProductTitle</h5>
                                        </div>
                                        <button class="btn btn-outline-danger btn-sm border-0 open-delete-modal" data-id="@item.CartItemID">
                                            <i class="uil uil-trash-alt"></i> حذف
                                        </button>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <ul class="list-unstyled small text-secondary">
                                                <li class="mb-2">
                                                    <i class="uil uil-check-circle text-warning me-2"></i>
                                                    <strong>عنوان سفارش:</strong>
                                                    @item.OrderTitle
                                                </li>

                                                @for (int i = 0; i < item.ProductFeatures.Count(); i++)
                                                {
                                                    <li class="mb-2">
                                                        <i class="uil uil-check-circle text-warning me-2"></i>
                                                        <strong>@item.ProductFeatures[i]:</strong>
                                                        @item.SelectedFeaturesValue[i]
                                                    </li>
                                                }
                                            </ul>
                                        </div>

                                        <div class="col-md-6 border-end-md">
                                            <p class="small fw-bold mb-2">خدمات پس از چاپ:</p>

                                            <div class="d-flex flex-wrap gap-2">
                                                @if (item.Services?.Any() == true)
                                                {
                                                    foreach (var service in item.Services)
                                                    {
                                                        <span class="badge rounded-pill bg-light text-dark border px-3">@service</span>
                                                    }
                                                }
                                            </div>
                                        </div>

                                        <div class="mt-4 pt-3 border-top">
                                            <p class="small fw-bold mb-2">فایل‌های آپلود شده:</p>

                                            <div class="d-flex flex-wrap gap-2">
                                                @if (item.Files?.Any() == true)
                                                {
                                                    foreach (var file in item.Files)
                                                    {
                                                        var ext = System.IO.Path.GetExtension(file.FileName).ToLowerInvariant();

                                                        if (ext == ".rar" || ext == ".zip" || ext == ".7z")
                                                        {
                                                            <div class="file-thumb position-relative border rounded p-1 bg-light d-flex flex-column align-items-center justify-content-center">
                                                                <i class="uil uil-server-alt text-danger fs-2"></i>
                                                                <span class="small" style="font-size:10px;">assets.rar</span>

                                                                <a asp-controller="Cart"
                                                                   asp-action="DownloadFile"
                                                                   asp-route-fileId="@file.Id"
                                                                   download
                                                                   class="btn btn-sm btn-dark position-absolute top-0 end-0 p-0 px-1 text-white">
                                                                    <i class="uil uil-download-alt"></i>
                                                                </a>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="file-thumb position-relative border rounded p-1">
                                                                <img src="/Uploads/Temp/Temp_@file.Id/@file.FileName"
                                                                     alt="Design"
                                                                     class="w-100 h-100 rounded">

                                                                <a asp-controller="Cart"
                                                                   asp-action="DownloadFile"
                                                                   asp-route-fileId="@file.Id"
                                                                   download
                                                                   class="btn btn-sm btn-dark position-absolute top-0 end-0 p-0 px-1 text-white">
                                                                    <i class="uil uil-download-alt"></i>
                                                                </a>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end align-items-center mt-3 pt-2 border-top border-light">
                                        <div class="text-start">
                                            <span class="text-muted small">قیمت نهایی این مورد:</span>
                                            <span class="h5 fw-bold text-dark mb-0 ms-2">
                                                @item.FinalPrice.ToPersianPrice() تومان
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-cart-card">

                            <div class="empty-cart-icon">
                                <i class="uil uil-shopping-cart-alt"></i>
                            </div>

                            <h4 class="fw-bold mb-3">
                                سبد خرید شما خالی است
                            </h4>

                            <p class="text-muted mb-4">
                                هنوز هیچ سفارشی به سبد خرید اضافه نکرده‌اید.
                                پس از انتخاب محصول، سفارش‌های شما در این بخش نمایش داده خواهند شد.
                            </p>

                            <div class="d-flex justify-content-center gap-2 flex-wrap">
                                <a href="/" class="btn btn-warning px-4 py-2 fw-bold">
                                    <i class="uil uil-shop me-1"></i>
                                    مشاهده محصولات
                                </a>

                                <a href="/ContactUs" class="btn btn-outline-secondary px-4 py-2">
                                    <i class="uil uil-phone-alt"></i>
                                    نیاز به مشاوره؟
                                </a>
                            </div>

                        </div>
                    }

                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3"><i class="uil uil-map-marker text-warning"></i> انتخاب آدرس ارسال</h6>
                        <div class="address-list">
                            @if (Model.UserAddresses?.Any() == true)
                            {
                                foreach (var address in Model.UserAddresses.Select((item, index) => new { item, index }))
                                {
                                    <div class="form-check address-card p-3 border rounded mb-2 @(address.index == 0 ? "active" : "")">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="address"
                                               id="@address.item.UserAddressId"
                                               @(address.index == 0 ? "checked" : "")>

                                        <label class="form-check-label small" for="@address.item.UserAddressId">
                                            <strong>@address.item.AddressTitle:</strong>
                                            @address.item.FullAddress
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning border-0 mb-0">ذ
                                    <i class="uil uil-map-marker-exclamation px-2 me-1"></i>
                                    هیچ آدرسی برای ارسال ثبت نشده است.
                                </div>
                            }
                        </div>
                        <a href="/UserPanel/Address/AddAddress" class="btn btn-link btn-sm text-decoration-none p-0 mt-2 text-warning">+ افزودن آدرس جدید</a>
                    </div>
                </div>

                <div class="card border-0 shadow-lg payment-final-card">
                    <div class="card-body p-4 text-white">
                        <h6 class="fw-bold mb-4">خلاصه فاکتور و پرداخت</h6>

                        <div class="discount-box-internal mb-4 p-3 rounded">
                            <label class="small mb-2 d-block">کد تخفیف دارید؟</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="discount-code" class="form-control border-0 bg-light text-dark" placeholder="کد را وارد کنید...">
                                <button class="btn btn-warning fw-bold px-3" id="apply-discount">اعمال</button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mb-2 text-light">
                            <span class="small">مبلغ کل:</span>
                            <span class="fw-bold">@Model.TotalPrice.ToPersianPrice() تومان</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-danger-light">
                            <span class="small">تخفیف:</span>
                            <span>۰ تومان</span>
                        </div>

                        <div class="d-flex justify-content-between mb-4 border-top border-secondary pt-3">
                            <span class="h6 fw-bold mb-0">مبلغ قابل پرداخت:</span>
                            <span class="h5 fw-bold text-warning mb-0">@Model.TotalPrice.ToPersianPrice() تومان</span>
                        </div>

                        <button class="btn btn-warning pay-btn w-100 py-3 fw-bold shadow-sm"
                                id="pay-btn"
                                data-has-address="@((Model.UserAddresses?.Any() == true).ToString().ToLower())"
                                @(Model.Items?.Any() == true ? "" : "disabled")>
                            تایید و پرداخت نهایی
                            <i class="uil uil-arrow-left ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered bottom-sheet-custom">
            <div class="modal-content border-0">
                <div class="drag-handle d-md-none"></div>

                <div class="modal-header custom-red-header">
                    <h6 class="modal-title fw-bold text-white w-100 text-center">آیا از حذف این سفارش مطمئن هستید؟</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4 text-center">
                    <p class="text-secondary mb-4 px-2" style="font-size: 0.9rem; line-height: 1.8;">
                        با حذف این سفارش، تمامی اطلاعات و فایل‌هایی که آپلود کردید به صورت <span class="text-danger fw-bold">دائمی</span> حذف خواهند شد.
                    </p>

                    <div class="row g-2 px-2">
                        <div class="col-12 col-sm-6 order-sm-2">
                            <button id="final-delete-btn"
                                    class="btn btn-danger w-100 py-3 fw-bold rounded-3">
                                بله، حذف شود
                            </button>
                            <input type="hidden" id="delete-cart-item-id" />
                            @* <a href="#" id="final-delete-link" class="btn btn-danger w-100 py-3 fw-bold rounded-3">بله، حذف شود</a> *@
                        </div>
                        <div class="col-12 col-sm-6 order-sm-1">
                            <button class="btn btn-light border w-100 py-3 fw-bold rounded-3" data-bs-dismiss="modal">انصراف</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="/js/shopcart.js"></script>
}