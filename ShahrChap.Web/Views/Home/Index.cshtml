    <div class="slider mt-3">
        <div id="carouselExampleControls" class="carousel slide slider-container container carousel-fade"
             data-bs-ride="true">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="/img/slider.jpg" class="d-block w-100" alt="...">
                </div>
                <div class="carousel-item">
                    <img src="/img/slider2.jpg" class="d-block w-100" alt="...">
                </div>
                <div class="carousel-item">
                    <img src="/img/slider3.jpg" class="d-block w-100" alt="...">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls"
                    data-bs-slide="next">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls"
                    data-bs-slide="prev">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
    <!--End Slider-->

    <div class="container mt-5">
        <!--Owl carouser-->
        <div class="bestsellers">
            <div class="title">
                <h4 class="text-gradient">محصولات پرفروش</h4>
                <a href="#" class="view-more">نمایش همه <i class="uil uil-arrow-left view-more-icon"></i></a>
            </div>
            <div class="title-underline"></div>

            <div dir="rtl" class="swiper products-swiper">
                <div class="swiper-wrapper ">
                    @foreach (var item in Model)
                    {
                        <div class="swiper-slide">

                            <partial name="_ProductBox" model="item" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <!--End Owl carouser-->
</section>

