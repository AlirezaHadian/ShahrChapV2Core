@page "{id}"
@model ShahrChap.Web.Pages.Admin.OrderStatus.EditOrderStatusModel
@{
    ViewData["Title"] = "- ویرایش وضعیت";
}
<div class="row mb-2">
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/Admin"><i class="uil uil-estate"></i> صفحه نخست</a></li>
            <li class="breadcrumb-item"><a href="/Admin/OrderStatus"><i class="uil uil-list-ul"></i> لیست وضعیت ها</a></li>
            <li class="breadcrumb-item active text-success"><i class="uil uil-list-ul"></i> ویرایش وضعیت @Model.OrderStatus.StatusTitle</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <h3>ویرایش وضعیت "@Model.OrderStatus.StatusTitle"</h3>
            <hr />
            <input type="hidden" asp-for="OrderStatus.StatusId" />
            <input type="hidden" asp-for="OrderStatus.IsDeleted" />
            <input type="hidden" asp-for="OrderStatus.SortOrder" />
            <div class="col-md-9">
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <div class="form-group">
                            <label>عنوان وضعیت</label>
                            <input type="text" asp-for="OrderStatus.StatusTitle" class="form-control">
                            <span asp-validation-for="OrderStatus.StatusTitle"></span>
                        </div>
                        <div class="form-group">
                            <label>رنگ</label>
                            <select asp-for="OrderStatus.OrderColor" class="form-control">
                                <option value="">انتخاب کنید</option>
                                <option value="Blue">آبی</option>
                                <option value="Green">سبز</option>
                                <option value="Yellow">زرد</option>
                                <option value="Red">قرمز</option>
                                <option value="White">سفید</option>
                            </select>
                            <span asp-validation-for="OrderStatus.OrderColor"></span>
                        </div>
                        <a href="/Admin/OrderStatus" class="btn btn-default"><i class="uil uil-angle-right"></i> بازگشت</a>
                        <button type="submit" class="btn btn-success"><i class="uil uil-edit"></i> ویرایش</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>