@page
@model ShahrChap.Web.Pages.Admin.OrderStatus.IndexModel
@functions {
    string ColorEmoji(string color)
    {
        return color switch
        {
            "green" => "🟩",
            "blue" => "🟦",
            "yellow" => "🟨",
            "orange" => "🟧",
            "red" => "🟥",
            "white" => "⬜",
            _ => ""
        };
    }
}
@{
    ViewData["Title"] = "- لیست وضعیت ها";
}

<div class="row mb-2">
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/Admin"><i class="uil uil-estate"></i> صفحه نخست</a></li>
            <li class="breadcrumb-item active text-success"><i class="uil uil-list-ul"></i> لیست وضعیت ها</li>
        </ol>
    </div>
</div>

<div class="col-lg-12">
    <h1 class="page-header">لیست وضعیت ها</h1>
    <hr />
</div>

<div class="col-lg-12">
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="table-responsive">
                <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                    <div class="row">
                        <div class="col-md-12 mb1">
                            <a asp-page="CreateOrderStatus" class="btn btn-outline btn-success"><i class="uil uil-book-medical"></i> افزودن وضعیت جدید</a>
                        </div>
                    </div>
                    @Html.AntiForgeryToken()
                    <table class="table table-striped table-bordered table-hover dataTable no-footer table-text-center" id="dataTables-example">
                        <thead>
                            <tr>
                                <th style="width:50px"></th>
                                <td>عنوان</td>
                                <td>دستورات</td>
                            </tr>
                        </thead>
                        <tbody id="sortable-body">
                            @foreach (var item in Model.OrderStatuses)
                            {
                                <tr data-id="@item.StatusId">
                                    <td>
                                        <i class="fas fa-grip-vertical handle" style="cursor:move; color:#888; font-size:20px"></i>
                                    </td>
                                    <td>
                                        <span>@ColorEmoji(item.StatusColor)</span>
                                        @item.StatusTitle
                                    </td>
                                    <td>
                                        <a asp-page="EditOrderStatus" asp-route-id="@item.StatusId" class="btn btn-sm btn-warning"><i class="uil uil-edit"></i></a>
                                        <a asp-page="DeleteOrderStatus" asp-route-id="@item.StatusId" class="btn btn-sm btn-danger"><i class="uil uil-trash-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.14.0/Sortable.min.js"></script>
    <script src="/AdminTemplate/dist/js/OrderStatus.js"></script>
}